@page
@model OnlineLearningSystem.Web.Pages.Instructor.DashboardModel

@{
    ViewData["Title"] = "Instructor Dashboard";
}

<div class="container py-5">

    
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold mb-2">Instructor Dashboard</h1>
            <p class="text-muted mb-0">
                Manage your courses and track your teaching activity.
            </p>
        </div>

        <a asp-page="/Courses/Create"
           class="btn btn-primary px-4">
            + Create Course
        </a>
    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-5">

        <!-- Total Courses -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-2">
                                Total Courses
                            </p>

                            <h2 class="fw-bold mb-1">
                                @Model.TotalCourses
                            </h2>

                            <small class="text-muted">
                                Courses you teach
                            </small>
                        </div>

                        <div class="rounded-circle bg-primary bg-opacity-10
                                p-3"
                             style="font-size: 28px;">
                            📚
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Total Students -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-2">
                                Total Students
                            </p>

                            <h2 class="fw-bold mb-1">
                                @Model.TotalStudents
                            </h2>

                            <small class="text-muted">
                                Students enrolled
                            </small>
                        </div>

                        <div class="rounded-circle bg-success bg-opacity-10
                                p-3"
                             style="font-size: 28px;">
                            👨‍🎓
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Average Rating -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-2">
                                Average Rating
                            </p>

                            <h2 class="fw-bold mb-1">
                                @Model.AverageRating.ToString("0.0")
                            </h2>

                            <small class="text-muted">
                                From your courses
                            </small>
                        </div>

                        <div class="rounded-circle bg-warning bg-opacity-10
                                p-3"
                             style="font-size: 28px;">
                            ⭐
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Quick Actions -->
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body p-4">

            <h3 class="fw-bold mb-1">
                Quick Actions
            </h3>

            <p class="text-muted mb-4">
                Quickly access the tools you use most.
            </p>

            <div class="row g-3">

                <div class="col-md-4">
                    <a asp-page="/Courses/Create"
                       class="btn btn-primary w-100 py-3">
                        ➕ Create Course
                    </a>
                </div>

                <div class="col-md-4">
                    <a asp-page="/Instructor/Courses"
                       class="btn btn-outline-primary w-100 py-3">
                        📚 Manage My Courses
                    </a>
                </div>

                <div class="col-md-4">
                    <a asp-page="/Courses/Index"
                       class="btn btn-outline-secondary w-100 py-3">
                        🔎 Browse All Courses
                    </a>
                </div>

            </div>

        </div>
    </div>

    <!-- Instructor Tips -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <h3 class="fw-bold mb-4">
                Instructor Tips
            </h3>

            <div class="row g-4">

                <div class="col-md-4">
                    <h5 class="fw-bold">
                        📖 Keep courses organized
                    </h5>

                    <p class="text-muted mb-0">
                        Use clear course titles and descriptions
                        to help students find the right content.
                    </p>
                </div>

                <div class="col-md-4">
                    <h5 class="fw-bold">
                        🎯 Track your students
                    </h5>

                    <p class="text-muted mb-0">
                        Monitor enrollment and progress to understand
                        how students are using your courses.
                    </p>
                </div>

                <div class="col-md-4">
                    <h5 class="fw-bold">
                        ⭐ Improve your content
                    </h5>

                    <p class="text-muted mb-0">
                        Keep your lessons updated and make your
                        learning material engaging and useful.
                    </p>
                </div>

            </div>

        </div>
    </div>
    

</div>
