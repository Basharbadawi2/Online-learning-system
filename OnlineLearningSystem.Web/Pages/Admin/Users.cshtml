@page
@model OnlineLearningSystem.Web.Pages.Admin.UsersModel

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">

        <div>
            <span class="text-uppercase text-primary fw-semibold small">
                ADMINISTRATION
            </span>

            <h1 class="fw-bold mb-2">
                Manage Users
            </h1>

            <p class="text-muted mb-0">
                View and manage students, instructors, and administrators.
            </p>
        </div>

        <a asp-page="/Admin/Dashboard"
           class="btn btn-outline-secondary">
            ← Dashboard
        </a>

    </div>


    <!-- Statistics -->
    <div class="row g-4 mb-5">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">
                        Total Users
                    </p>

                    <h2 class="fw-bold mb-0">
                        @Model.Users.Count
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">
                        Students
                    </p>

                    <h2 class="fw-bold mb-0">
                        @Model.Users.Count(u => u.Role == "Student")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">
                        Instructors
                    </p>

                    <h2 class="fw-bold mb-0">
                        @Model.Users.Count(u => u.Role == "Instructor")
                    </h2>
                </div>
            </div>
        </div>

    </div>


    <!-- Users Table -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <div class="p-4 border-bottom">

                <h4 class="fw-bold mb-1">
                    All Users
                </h4>

                <p class="text-muted mb-0">
                    Manage registered users on the platform.
                </p>

            </div>


            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="px-4">
                                #
                            </th>

                            <th>
                                User
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Role
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end px-4">
                                Actions
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var user in Model.Users)
                        {
                            <tr>

                                <td class="px-4">
                                    @user.UserId
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @user.FullName
                                    </div>
                                </td>

                                <td>
                                    <span class="text-muted">
                                        @user.Email
                                    </span>
                                </td>

                                <td>

                                    @if (user.Role == "Instructor")
                                    {
                                        <span class="badge bg-dark">
                                            Instructor
                                        </span>
                                    }
                                    else if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">
                                            Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">
                                            Student
                                        </span>
                                    }

                                </td>

                                <td>
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                </td>

                                <td class="text-end px-4">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary me-1">
                                        View
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger">
                                        Disable
                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- Back -->
    <div class="mt-4">

        <a asp-page="/Admin/Dashboard"
           class="text-decoration-none">
            ← Back to Admin Dashboard
        </a>

    </div>
    

</div>
