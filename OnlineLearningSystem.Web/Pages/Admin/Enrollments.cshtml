@page
@model OnlineLearningSystem.Web.Pages.Admin.EnrollmentsModel

@{
    ViewData["Title"] = "Enrollments";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-5">

        <div>
            <span class="text-uppercase text-primary fw-semibold small">
                ADMINISTRATION
            </span>

            <h1 class="fw-bold mb-2">
                Enrollments
            </h1>

            <p class="text-muted mb-0">
                Monitor all student enrollments on the platform.
            </p>
        </div>

        <a asp-page="/Admin/Dashboard"
           class="btn btn-outline-secondary">
            ← Dashboard
        </a>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <div class="p-4 border-bottom">
                <h4 class="fw-bold mb-1">
                    All Enrollments
                </h4>

                <p class="text-muted mb-0">
                    <strong>@Model.Enrollments.Count</strong> enrollment(s).
                </p>
            </div>

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="px-4">#</th>
                            <th>Course</th>
                            <th>Student ID</th>
                            <th>Enrolled On</th>
                            <th>Progress</th>
                            <th class="text-end px-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!Model.Enrollments.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    No enrollments yet.
                                </td>
                            </tr>
                        }

                        @foreach (var enrollment in Model.Enrollments)
                        {
                            <tr>
                                <td class="px-4">
                                    @enrollment.EnrollmentId
                                </td>

                                <td>
                                    <span class="fw-semibold">
                                        @enrollment.Course?.Title
                                    </span>
                                </td>

                                <td>
                                    @enrollment.StudentId
                                </td>

                                <td>
                                    @enrollment.EnrolledAt.ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1"
                                             style="height: 8px; width: 80px;">
                                            <div class="progress-bar bg-primary"
                                                 role="progressbar"
                                                 style="width: @enrollment.ProgressPercent%">
                                            </div>
                                        </div>

                                        <span class="small text-muted">
                                            @enrollment.ProgressPercent.ToString("0")%
                                        </span>
                                    </div>
                                </td>

                                <td class="text-end px-4">
                                    <a asp-page="/Courses/Details"
                                       asp-route-id="@enrollment.CourseId"
                                       class="btn btn-sm btn-outline-primary">
                                        View Course
                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <div class="mt-4">

        <a asp-page="/Admin/Dashboard"
           class="text-decoration-none">
            ← Back to Admin Dashboard
        </a>

    </div>

</div>