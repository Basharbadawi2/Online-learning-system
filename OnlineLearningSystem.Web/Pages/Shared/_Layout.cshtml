@inject OnlineLearningSystem.Web.Services.IAuthSession Session
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LearnHub</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnlineLearningSystem.Web.styles.css" asp-append-version="true" />
</head>
<body>

    <nav class="navbar navbar-expand-lg custom-navbar">

        <div class="container">

            <a class="navbar-brand fw-bold text-white"
               asp-page="/Index">
                🎓 LearnHub
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarContent">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link text-white"
                           asp-page="/Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white"
                           asp-page="/Courses/Index">
                            Courses
                        </a>
                    </li>

                    @if (Session.IsLoggedIn)
                    {
                        @if (Session.Role.Equals("Student", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-page="/Student/Dashboard">
                                    My Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-page="/Student/Certificates">
                                    Certificates
                                </a>
                            </li>
                        }

                        @if (Session.Role.Equals("Instructor", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-page="/Instructor/Dashboard">
                                    Instructor Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-page="/Instructor/Courses">
                                    My Courses
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-page="/Instructor/Profile">
                                    Profile
                                </a>
                            </li>
                        }

                        @if (Session.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-page="/Admin/Dashboard">
                                    Admin Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-page="/Admin/Users">
                                    Users
                                </a>
                            </li>
                        }
                    }

                </ul>

                <form class="d-flex me-3">
                    <input class="form-control"
                           type="search"
                           placeholder="Search courses..." />
                </form>

                <div class="d-flex gap-2 align-items-center">

                    @if (Session.IsLoggedIn)
                    {
                        <span class="text-white fw-semibold">
                            👤 @Session.FullName
                        </span>

                        <form method="post"
                              asp-page="/Auth/Logout">
                            <button type="submit"
                                    class="btn btn-outline-light btn-sm">
                                Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light"
                           asp-page="/Auth/Register">
                            Register
                        </a>

                        <a class="btn btn-light"
                           asp-page="/Auth/Login">
                            Login
                        </a>
                    }

                </div>

            </div>

        </div>

    </nav>

    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>